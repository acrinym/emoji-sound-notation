{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/esn/esn-playback-1.schema.json",
  "title": "Emoji Sound Notation Playback Bindings 1",
  "type": "object",
  "required": ["format", "profiles"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "esn-playback/1"},
    "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 96000},
    "seed": {"type": "integer"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["source", "gesture", "mode"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "gesture": {"type": "string", "minLength": 1},
        "mode": {"enum": ["oscillator", "noise", "impulse"]},
        "wave": {"enum": ["sine", "triangle", "square", "saw"]},
        "gain": {"type": "number", "minimum": 0, "maximum": 1},
        "attack": {"type": "number", "minimum": 0, "maximum": 10},
        "release": {"type": "number", "minimum": 0, "maximum": 10},
        "noise_shape": {"enum": ["white", "soft"]},
        "base_hz": {"type": "number", "minimum": 1, "maximum": 24000}
      }
    }
  }
}
