{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/esn/esn-sound-pack-1.schema.json",
  "title": "Emoji Sound Notation Sound Pack 1",
  "type": "object",
  "required": ["format", "id", "name", "version", "license", "provenance", "fallback", "bindings"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "esn-sound-pack/1"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "license": {"$ref": "#/$defs/license"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "fallback": {"const": "reference_synth"},
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "spdx": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["creator"],
      "additionalProperties": false,
      "properties": {
        "creator": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "binding": {
      "type": "object",
      "required": ["source", "gesture", "asset"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "gesture": {"type": "string", "minLength": 1},
        "asset": {"type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.wav$"},
        "gain": {"type": "number", "minimum": 0, "maximum": 4},
        "loop": {"type": "boolean"},
        "root_note": {"type": "string", "minLength": 1},
        "credit": {"type": "string"}
      }
    }
  }
}