[train]
name        = "beadtrain_5_sound_pack_realization"
title       = "Beadtrain 5 - Swappable sound-pack realization"
description = """
Make ESN sound scenes useful with recorded/local samples while preserving semantic event identity and a safe reference-synth fallback.
"""
created     = "2026-09-09"
status      = "in_progress"

[[cars]]
id             = "contract"
bead           = "emoji-sound-notation-2dd.1"
title          = "Define sound-pack contract and provenance model"
parallel_start = false
depends_on     = []
summary        = "Define esn-sound-pack/1, sample bindings, fallback behavior, pitch-root/loop controls, and licensing/provenance metadata."

[[cars]]
id             = "offline_render"
bead           = "emoji-sound-notation-2dd.2"
title          = "Implement deterministic sample-backed offline rendering"
parallel_start = true
depends_on     = ["contract"]
summary        = "Mix PCM WAV assets deterministically and fall back to reference synthesis when sample realization is unavailable."

[[cars]]
id             = "browser_pack"
bead           = "emoji-sound-notation-2dd.3"
title          = "Add browser sound-pack loading and realization selection"
parallel_start = true
depends_on     = ["contract"]
summary        = "Load local sound-pack folders, resolve sample bindings, expose provenance, and preview with graceful fallback."

[[cars]]
id             = "local_samples"
bead           = "emoji-sound-notation-2dd.4"
title          = "Add user sample overrides and local-first workflow"
parallel_start = false
depends_on     = ["browser_pack"]
summary        = "Attach local WAV files to source/action semantics with optional looping and root pitch without rewriting the ESN score."

[[cars]]
id             = "qualify"
bead           = "emoji-sound-notation-2dd.5"
title          = "Qualify Beadtrain 5 end to end"
parallel_start = false
depends_on     = ["offline_render", "browser_pack", "local_samples"]
summary        = "Prove deterministic rendering, browser sample workflow, fallback safety, semantic invariance, CI, and exact-head receipts."

[meta]
one_liner    = "Swap how a sound is heard without changing what the ESN event means."
couples_with = []
