[train]
name        = "beadtrain_1_semantic_foundation"
title       = "Beadtrain 1 — Semantic score foundation"
description = """
Build the first executable vertical slice of emoji-native sound notation: semantic contract, registry, deterministic validation, rendering, example score, and qualification.
"""
created     = "2026-09-08"
status      = "complete"

[[cars]]
id             = "spec"
bead           = "emoji-sound-notation-02l.1"
title          = "Define ESN-1 semantic and file-format contract"
parallel_start = false
depends_on     = []
summary        = "Define sound-source, gesture, pitch/unpitched, timing, dynamics, trajectory, registry, and accessibility semantics."

[[cars]]
id             = "model"
bead           = "emoji-sound-notation-02l.2"
title          = "Implement semantic model and deterministic validator"
parallel_start = false
depends_on     = ["spec"]
summary        = "Implement strict ESN-1 loading, registry validation, canonicalization, and CLI validation."

[[cars]]
id             = "render"
bead           = "emoji-sound-notation-02l.3"
title          = "Implement SVG semantic score renderer"
parallel_start = true
depends_on     = ["model"]
summary        = "Render time, pitch, source identity, duration, dynamics, pitch trajectories, and explicit unpitched lanes."

[[cars]]
id             = "registry"
bead           = "emoji-sound-notation-02l.4"
title          = "Create core sound registry and reference score"
parallel_start = true
depends_on     = ["model"]
summary        = "Exercise instrument, animal, environmental, Foley, and percussion semantics in one reference score."

[[cars]]
id             = "qualify"
bead           = "emoji-sound-notation-02l.5"
title          = "Qualify Beadtrain 1 end to end"
parallel_start = false
depends_on     = ["render", "registry"]
summary        = "Run tests and deterministic CLI/render checks, then capture exact-state receipts."

[meta]
one_liner    = "From idea to executable emoji-native semantic sound score."
couples_with = []
